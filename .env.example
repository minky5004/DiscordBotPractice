DISCORD_BOT_TOKEN=
DB_URL=jdbc:postgresql://localhost:5432/enkephalin
DB_USER=enkephalin
# 영숫자만. 같은 파일을 compose 는 $ 를 변수로, 봇(Properties)은 \ 를 이스케이프로 읽어 서로 다른 값이 된다.
# DB 볼륨은 첫 기동의 비밀번호로 굳으므로, 바꾸려면 docker compose down -v 로 볼륨부터 지운다.
DB_PASSWORD=

# 림버스 컴퍼니 설치 폴더. 비우면 /인격 없이 뜬다.
# 경로 구분은 / · 따옴표 없이 — 봇은 이 파일을 Properties 로 읽어 \ 를 이스케이프로 · 따옴표를 경로 글자로 처리한다.
# 예: LIMBUS_DIR=C:/Program Files (x86)/Steam/steamapps/common/Limbus Company
LIMBUS_DIR=
